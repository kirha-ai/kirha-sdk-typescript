{
  "name": "kirha",
  "version": "0.1.3",
  "description": "Official TypeScript SDK for the Kirha Search API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && bun run build:types",
    "build:types": "tsc --project tsconfig.build.json",
    "test": "bun test",
    "lint": "biome check --write",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "kirha",
    "search",
    "ai",
    "api",
    "sdk"
  ],
  "author": "Kirha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirha-ai/kirha-sdk-typescript"
  },
  "dependencies": {
    "@kirha/planner": "^0.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
